<?xml version="1.0" encoding="utf-8"?>
<!-- Draggable popup shown on top of a map, showing the coordinates + elevation of a point -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:elevation="8dp">

    <LinearLayout
        android:id="@+id/popup_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/map_popup_background"
        android:minWidth="230dp"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/popup_coordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/popup_elevation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#5D5D5D"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/popup_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:padding="8dp"
            android:src="@drawable/ic_clear_white_48dp"
            android:tint="#61000000"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/map_popup_close" />
    </LinearLayout>

    <View
        android:id="@+id/popup_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/map_popup_dot" />
</LinearLayout>
